{
  "name": "repack-atlas",
  "version": "0.0.1",
  "description": "Local developer tooling for React Native Module Federation workspaces built with Re.Pack.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "repack-atlas": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/repack-bridge/plugin.d.ts",
      "default": "./dist/repack-bridge/plugin.js"
    },
    "./introspection": {
      "types": "./dist/repack-bridge/introspection-plugin.d.ts",
      "default": "./dist/repack-bridge/introspection-plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check:vendored": "node scripts/vendored-check.mjs",
    "agent:sync": "node scripts/agent-sync.mjs",
    "agent:check": "node scripts/agent-sync.mjs --check",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "peerDependencies": {
    "@callstack/repack": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
